// Schema gerado por `npx prisma db pull` (introspecção do RDS real) em 2026-09-25.
// Re-executado em 2026-09-29: hora_inicio_pesagem, hora_fim_pesagem, mais_pesado,
// mais_leve e valor_medio de `negocio` passaram a aceitar NULL (não se aplicam à
// modalidade "cabeca", que não tem pesagem individual).
// Re-executado em 2026-10-02: negocio.tipo_precificacao removida; negocio.porcentagem_comissao
// adicionada (comissao passa a ser o valor em R$ calculado a partir dela); gado.horario_pesagem
// passou a ser NOT NULL (sempre preenchido pelo servidor).
// 2026-10-03: uuid_origem (opcional, único) em fazenda, pecuarista, comprador, negocio e gado —
// idempotência da sincronização offline (prisma/sql/2026-10-03-uuid-origem.sql; confirmado
// via `npx prisma db pull` em 2026-10-03).
// CHECK constraints existentes no banco não são representadas aqui (Prisma não suporta
// check constraints nativamente) — continuam sendo validadas via class-validator nos DTOs:
//   - negocio.modalidade: "arroba" | "kg" | "cabeca"
//   - negocio.porcentagem_comissao: entre 0 e 100
//   - negocio.tipo_gado: "Gordo" | "Reposicao"
//   - usuario.nivel_acesso: "Admin" | "Normal"
//   - pecuarista.fisico_juridico: "fisico" | "juridico"
// 2026-10-04: usuario.primeiro_acesso (NOT NULL DEFAULT TRUE) — fluxo de primeiro acesso.
// 2026-10-17: fluxo de primeiro acesso removido; usuario.primeiro_acesso saiu do schema (a coluna
// continua no banco, zerada, até o DROP opcional de prisma/sql/script-ajustes-reuniao-cliente.sql).
// 2026-10-13: campos calculados do romaneio em negocio (peso_total_quilos, peso_total_arroba,
// rendimento_medio, peso_medio_arroba, peso_medio_quilos, funrural, senar) — preenchidos
// pela API em recalcularAgregados() (prisma/sql/script-campos-calculados-negocio.sql).
// 2026-10-17: pecuarista (nome novo no sistema). O banco NÃO foi renomeado: os models/campos
// pecuarista* apontam para as tabelas/colunas originais via @map/@@map — ao rodar
// `prisma db pull`, refazer esses mapeamentos.
// 2026-10-17: empresa.aliquota_funrural/aliquota_senar (NOT NULL, padrão 1,50 e 0,20, em %) e
// negocio.aliquota_funrural/aliquota_senar (alíquotas usadas por aquele negócio, copiadas da
// empresa na criação) — prisma/sql/script-ajustes-reuniao-cliente.sql. CHECK entre 0 e 100.
// 2026-10-26: novo modelo de dados (planejamento-bd-8, script-banco-completo-criar-e-popular.sql,
// banco recriado do zero — atualizacoes-novoBD.md):
//   - gado: sem rendimento_carcaca e carimbo; denominacao guarda a categoria de rendimento
//     ("Nelore" | "Anelorado" | "Angus" | "Composto").
//   - negocio: tipo_negocio ("Desconto em folha" | "Livre" | "Funrural"), os quatro
//     porcentagem_rendimento_* (0 a 100) e media_carimbo, todos NOT NULL; tipo_gado passa a
//     ser "Gordo" | "Reposicao"; funrural/senar NUMERIC(15, 2).
//   - negocio → vendedor_fazenda por FK composta (vendedor_id, fazenda_id): a fazenda do
//     negócio precisa pertencer ao pecuarista. PK de vendedor_fazenda: (vendedor_id, fazenda_id).
//   - vendedor: agencia VARCHAR(10), conta VARCHAR(20).
//   - negocio.media_carimbo: VARCHAR(30), texto livre (ex.: "8,9 e 10") — ampliado no banco
//     em relação ao VARCHAR(5) do planejamento.
// CHECKs novos (validados também nos DTOs): negocio.tipo_negocio, negocio.tipo_gado,
// negocio.porcentagem_rendimento_* e empresa.aliquota_* entre 0 e 100.
// 2026-11-01: lotes (planejamento-bd-11, script-banco-completo-criar-e-popular.sql, banco
// recriado do zero — instrucoes-atualizacoesbd11.md). Negócio 1:N Lote 1:N Gado:
//   - lote (nova): nome_lote, valor_unidade, tipo_lote, genero, rendimento_carcaca (0–100),
//     media_carimbo, ano_carimbo e os agregados calculados pela API. ON DELETE CASCADE.
//   - negocio: sem tipo_lote, valor_unidade, media_carimbo e porcentagem_rendimento_*;
//     mais_pesado/mais_leve viraram mais_pesado_quilos/_arroba e mais_leve_quilos/_arroba;
//     tipo_negocio VARCHAR(20).
//   - gado: sem negocio_id, genero, denominacao e ano_carimbo; pertence ao negócio só pelo
//     lote (lote_id, ON DELETE CASCADE).
//   - fazenda: localizacao_google VARCHAR(500) e endereco_fazenda VARCHAR(200), opcionais.
// CHECKs do lote (validados nos DTOs): tipo_lote, genero ("Macho" | "Femea") e
// rendimento_carcaca entre 0 e 100.
// 2026-11-06: bd-12 (script-banco-completo-criar-e-popular.sql, banco recriado do zero —
// atualizacao-bd12.md):
//   - negocio.valor_unidade (NOT NULL) volta para o negócio: um único preço para todos os
//     lotes; lote.valor_unidade saiu.
// bd-13:
//   - lote.valor_unidade (NOT NULL) de volta: cada lote tem o seu preço; saiu de negocio.
//   - negocio.valor_total → valor_total_bruto; novo valor_total_liquido (bruto − Funrural − Senar).
//   - comprador (frigorífico): sai pessoa_contato, entra inscricao_estadual (NOT NULL).
//   - lote.media_carimbo e lote.ano_carimbo opcionais.
//   - comprador sem telefone; fazenda.cnpj opcional.
//   - comprador do negócio: frigorífico (comprador_id) OU pecuarista
//     (comprador_pecuarista_id → vendedor). CHECKs no banco: exatamente um preenchido
//     (negocio_comprador_ck) e pecuarista comprador ≠ vendedor (negocio_comprador_diferente_ck).
//   - tipos_gado (nova): catálogo de nomes sugeridos para lotes, por empresa, sem FK com lote.
//     Índice único (empresa_id, lower(nome_gado)) — expressão que o Prisma não modela;
//     a unicidade sem maiúsculas é checada em TiposGadoService.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model empresa {
  empresa_id        Int          @id @default(autoincrement())
  cnpj              String       @db.VarChar(18)
  creci             String       @db.VarChar(20)
  nome              String       @db.VarChar(50)
  banco             String       @db.VarChar(20)
  chave_pix         String       @db.VarChar(50)
  agencia           String       @db.VarChar(4)
  conta             String       @db.VarChar(10)
  aliquota_funrural Decimal      @default(1.50) @db.Decimal(5, 2)
  aliquota_senar    Decimal      @default(0.20) @db.Decimal(5, 2)
  negocios          negocio[]
  usuarios          usuario[]
  tipos_gado        tipos_gado[]

  @@map("empresa")
}

model usuario {
  usuario_id   Int     @id @default(autoincrement())
  empresa_id   Int
  nome         String  @db.VarChar(50)
  sobrenome    String  @db.VarChar(50)
  nivel_acesso String  @db.VarChar(10)
  email        String  @unique @db.VarChar(254)
  senha        String  @db.VarChar(255)
  empresa      empresa @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("usuario")
}

model fazenda {
  fazenda_id         Int                  @id @default(autoincrement())
  nome_fazenda       String               @db.VarChar(50)
  municipio          String               @db.VarChar(20)
  cnpj               String?              @db.VarChar(18)
  inscricao_estadual String               @db.VarChar(12)
  marca_url          String?              @db.VarChar(500)
  marca_escrita      String?              @db.VarChar(10)
  localizacao_google String?              @db.VarChar(500)
  endereco_fazenda   String?              @db.VarChar(200)
  uuid_origem        String?              @unique @db.Uuid
  negocios           negocio[]
  pecuarista_fazenda pecuarista_fazenda[]

  @@map("fazenda")
}

model pecuarista {
  pecuarista_id      Int                  @id @default(autoincrement()) @map("vendedor_id")
  nome_pecuarista    String               @map("nome_vendedor") @db.VarChar(50)
  fisico_juridico    String               @db.VarChar(8)
  cpf_cnpj           String               @db.VarChar(20)
  banco              String               @db.VarChar(20)
  agencia            String               @db.VarChar(10)
  conta              String               @db.VarChar(20)
  chave_pix          String               @db.VarChar(50)
  uuid_origem        String?              @unique @db.Uuid
  negocio            negocio[]            @relation("negocio_vendedor")
  /// Negócios em que o pecuarista é o comprador.
  compras            negocio[]            @relation("negocio_comprador_pecuarista")
  pecuarista_fazenda pecuarista_fazenda[]

  @@map("vendedor")
}

model negocio {
  negocio_id              Int                @id @default(autoincrement())
  empresa_id              Int
  fazenda_id              Int
  /// Comprador frigorífico; exatamente um entre comprador_id e comprador_pecuarista_id.
  comprador_id            Int?
  /// Comprador pecuarista (tabela vendedor); nunca o próprio vendedor do negócio.
  comprador_pecuarista_id Int?
  pecuarista_id           Int                @map("vendedor_id")
  hora_inicio_pesagem     DateTime?          @db.Time(6)
  hora_fim_pesagem        DateTime?          @db.Time(6)
  valor_total_bruto       Decimal            @db.Decimal(15, 2)
  /// valor_total_bruto − funrural − senar (calculado pela API).
  valor_total_liquido     Decimal?           @db.Decimal(15, 2)
  valor_medio             Decimal?           @db.Decimal(15, 2)
  qtd_animais             Int
  modalidade              String             @db.VarChar(6)
  tipo_gado               String             @db.VarChar(9)
  tipo_negocio            String             @db.VarChar(20)
  mais_pesado_quilos      Decimal?           @db.Decimal(15, 2)
  mais_leve_quilos        Decimal?           @db.Decimal(15, 2)
  mais_pesado_arroba      Decimal?           @db.Decimal(15, 2)
  mais_leve_arroba        Decimal?           @db.Decimal(15, 2)
  data_negocio            DateTime           @db.Timestamp(6)
  porcentagem_comissao    Decimal?           @db.Decimal(5, 2)
  comissao                Decimal?           @db.Decimal(15, 2)
  observacao              String?            @db.VarChar(100)
  peso_total_quilos       Decimal?           @db.Decimal(14, 4)
  peso_total_arroba       Decimal?           @db.Decimal(14, 4)
  rendimento_medio        Decimal?           @db.Decimal(8, 4)
  peso_medio_arroba       Decimal?           @db.Decimal(14, 4)
  peso_medio_quilos       Decimal?           @db.Decimal(14, 4)
  funrural                Decimal?           @db.Decimal(15, 2)
  senar                   Decimal?           @db.Decimal(15, 2)
  aliquota_funrural       Decimal?           @db.Decimal(5, 2)
  aliquota_senar          Decimal?           @db.Decimal(5, 2)
  uuid_origem             String?            @unique @db.Uuid
  lotes                   lote[]
  comprador               comprador?         @relation(fields: [comprador_id], references: [comprador_id], onDelete: NoAction, onUpdate: NoAction)
  comprador_pecuarista    pecuarista?        @relation("negocio_comprador_pecuarista", fields: [comprador_pecuarista_id], references: [pecuarista_id], onDelete: NoAction, onUpdate: NoAction)
  empresa                 empresa            @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  fazenda                 fazenda            @relation(fields: [fazenda_id], references: [fazenda_id], onDelete: NoAction, onUpdate: NoAction)
  pecuarista              pecuarista         @relation("negocio_vendedor", fields: [pecuarista_id], references: [pecuarista_id], onDelete: NoAction, onUpdate: NoAction)
  // FK composta: a fazenda do negócio precisa estar vinculada ao pecuarista do negócio.
  pecuarista_fazenda      pecuarista_fazenda @relation(fields: [pecuarista_id, fazenda_id], references: [pecuarista_id, fazenda_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([empresa_id], map: "idx_negocio_empresa")
  @@index([data_negocio], map: "idx_negocio_data")
  @@map("negocio")
}

model lote {
  lote_id                 Int      @id @default(autoincrement())
  negocio_id              Int
  nome_lote               String   @db.VarChar(30)
  tipo_lote               String   @db.VarChar(8)
  /// Preço por unidade deste lote (R$/@, R$/kg ou R$/cabeça, conforme a modalidade).
  valor_unidade           Decimal  @db.Decimal(15, 2)
  genero                  String   @db.VarChar(6)
  rendimento_carcaca      Decimal  @db.Decimal(5, 2)
  media_carimbo           String?  @db.VarChar(30)
  ano_carimbo             String?  @db.VarChar(4)
  qtd_animais             Int
  valor_total_lote        Decimal  @db.Decimal(15, 2)
  valor_medio_cabeca_lote Decimal? @db.Decimal(15, 2)
  mais_pesado_quilos      Decimal? @db.Decimal(15, 2)
  mais_leve_quilos        Decimal? @db.Decimal(15, 2)
  mais_pesado_arroba      Decimal? @db.Decimal(15, 2)
  mais_leve_arroba        Decimal? @db.Decimal(15, 2)
  peso_total_quilos       Decimal? @db.Decimal(14, 4)
  peso_total_arroba       Decimal? @db.Decimal(14, 4)
  rendimento_medio        Decimal? @db.Decimal(8, 4)
  peso_medio_arroba       Decimal? @db.Decimal(14, 4)
  peso_medio_quilos       Decimal? @db.Decimal(14, 4)
  uuid_origem             String?  @unique @db.Uuid
  gados                   gado[]
  negocio                 negocio  @relation(fields: [negocio_id], references: [negocio_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([negocio_id], map: "idx_lote_negocio")
  @@map("lote")
}

model gado {
  gado_id         Int      @id @default(autoincrement())
  lote_id         Int
  horario_pesagem DateTime @db.Time(6)
  valor_total     Decimal  @db.Decimal(15, 2)
  peso_arroba     Decimal  @db.Decimal(15, 2)
  peso_calculo    Decimal  @db.Decimal(15, 2)
  peso_total      Decimal  @db.Decimal(15, 2)
  data_pesagem    DateTime @db.Timestamp(6)
  uuid_origem     String?  @unique @db.Uuid
  lote            lote     @relation(fields: [lote_id], references: [lote_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lote_id], map: "idx_gado_lote")
  @@map("gado")
}

model comprador {
  comprador_id       Int       @id @default(autoincrement())
  nome_empresa       String    @db.VarChar(50)
  cnpj               String    @db.VarChar(18)
  inscricao_estadual String    @db.VarChar(12)
  municipio          String    @db.VarChar(30)
  uuid_origem        String?   @unique @db.Uuid
  negocio            negocio[]
}

model pecuarista_fazenda {
  pecuarista_id Int        @map("vendedor_id")
  fazenda_id    Int
  negocios      negocio[]
  fazenda       fazenda    @relation(fields: [fazenda_id], references: [fazenda_id], onDelete: NoAction, onUpdate: NoAction)
  pecuarista    pecuarista @relation(fields: [pecuarista_id], references: [pecuarista_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([pecuarista_id, fazenda_id])
  @@map("vendedor_fazenda")
}

/// Nomes sugeridos para lotes (ex.: Nelore, Angus). O nome escolhido é copiado para
/// lote.nome_lote: renomear ou excluir um tipo não altera lotes existentes.
model tipos_gado {
  tipo_gado_id Int     @id @default(autoincrement())
  empresa_id   Int
  nome_gado    String  @db.VarChar(30)
  uuid_origem  String? @unique @db.Uuid
  empresa      empresa @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tipos_gado")
}
